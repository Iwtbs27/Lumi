<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:padding="18dp" android:orientation="vertical"
    android:background="@drawable/bg_ui_card">
    <TextView android:id="@+id/task_queue_instruction" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="18sp" android:fontFamily="sans-serif-medium"
        android:textColor="@color/on_surface" android:maxLines="4" android:ellipsize="end" />
    <TextView android:id="@+id/task_queue_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp"
        android:textColor="@color/on_surface_medium" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/task_queue_error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp"
        android:textColor="@color/color_danger" android:visibility="gone" />
    <LinearLayout android:id="@+id/task_queue_actions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end"
        android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/task_queue_primary"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/task_queue_more"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:minHeight="48dp" android:text="@string/task_queue_more" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
