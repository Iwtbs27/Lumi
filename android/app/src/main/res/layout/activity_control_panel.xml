<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface"
    android:fitsSystemWindows="true">

    <LinearLayout android:id="@+id/status_bar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="24dp" android:paddingVertical="12dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_ui_logo" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textColor="@color/on_surface"
                android:textSize="28sp" android:fontFamily="@font/lumi_wordmark" android:fontVariationSettings="'wght' 850"/>
            <TextView android:id="@+id/text_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/ui_ready"
                android:textColor="@color/on_surface_medium" android:textSize="12sp"
                android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_chat"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:clipToPadding="false"/>
        <ScrollView android:id="@+id/routines_container" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/text_greeting" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/greeting_morning"
                            android:textColor="@color/on_surface" android:textSize="28sp"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/ui_home_intro" android:textColor="@color/on_surface_medium"
                            android:textSize="15sp" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="132dp" android:layout_height="140dp"
                        android:src="@drawable/bg_ui_hero" android:importantForAccessibility="no"/>
                </LinearLayout>

                <TextView android:id="@+id/label_recommended" style="@style/OpenCyvis.Ui.Section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ui_recommended" android:layout_marginTop="16dp" android:layout_marginBottom="12dp"/>
                <LinearLayout android:id="@+id/card_recommended" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="100dp" android:orientation="horizontal"
                    android:gravity="center_vertical" android:background="@drawable/bg_recommended_card"
                    android:padding="20dp" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/recommended_icon" android:layout_width="44dp"
                        android:layout_height="48dp" android:gravity="center" android:textSize="28sp"
                        android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="12dp">
                        <TextView android:id="@+id/recommended_name" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/on_surface"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/recommended_desc" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/on_surface_medium"
                            android:textSize="13sp" android:lineSpacingExtra="2dp" android:layout_marginTop="6dp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_ui_arrow_forward" android:importantForAccessibility="no"/>
                </LinearLayout>

                <TextView style="@style/OpenCyvis.Ui.Section" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/ui_quick_actions"
                    android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_routine_chips"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" android:overScrollMode="never" android:clipToPadding="false"/>

                <TextView android:id="@+id/label_recent" style="@style/OpenCyvis.Ui.Section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ui_recent_tasks" android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/container_recent_routines" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:id="@+id/input_bar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/action_buttons" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center" android:visibility="gone" android:paddingBottom="10dp">
            <Button android:id="@+id/btn_view_operation" style="@style/OpenCyvis.Button.Custom"
                android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/ui_view_task"
                android:textSize="14sp" android:textColor="@color/on_brand_container"
                android:background="@drawable/bg_action_btn" android:textAllCaps="false"/>
            <Button android:id="@+id/btn_stop" style="@style/OpenCyvis.Button.Custom"
                android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/ui_stop_task"
                android:textSize="14sp" android:textColor="@color/color_danger"
                android:background="@drawable/bg_action_btn_danger" android:textAllCaps="false"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_ui_card" android:padding="8dp">
            <EditText android:id="@+id/edit_input" android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="64dp" android:layout_weight="1"
                android:hint="@string/ui_task_hint" android:inputType="textCapSentences|textMultiLine"
                android:background="@null" android:paddingHorizontal="12dp" android:paddingVertical="12dp"
                android:textSize="15sp" android:textColor="@color/on_surface" android:gravity="center_vertical"
                android:textColorHint="@color/on_surface_hint" android:maxLines="3"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_voice_input"
                style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp"
                android:layout_height="48dp" app:icon="@drawable/ic_ui_mic"
                app:iconTint="@color/color_accent" android:contentDescription="@string/ui_voice_input"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_send"
                style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="48dp"
                android:layout_height="48dp" app:icon="@drawable/ic_ui_send" app:iconTint="@color/on_accent"
                app:backgroundTint="@color/color_accent" android:contentDescription="@string/ui_send"/>
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/view_bottom_navigation"/>
</LinearLayout>
