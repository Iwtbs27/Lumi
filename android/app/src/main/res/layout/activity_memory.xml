<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface" android:fitsSystemWindows="true">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" app:elevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_scrollFlags="scroll|enterAlways">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="72dp" android:gravity="center_vertical" android:paddingHorizontal="20dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginEnd="12dp" android:src="@drawable/ic_ui_logo"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/memory_title" android:textSize="28sp" android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
        <Button style="@style/OpenCyvis.Button.Custom" android:id="@+id/btn_add_memory" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_ui_tonal" android:contentDescription="@string/mui_add_memory"
            android:drawableStart="@drawable/ic_ui_plus" android:drawableTint="@color/color_accent"
            android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="12dp"
        android:text="@string/mp_library_description" android:textColor="@color/on_surface_medium" android:textSize="14sp" />
    <EditText android:id="@+id/edit_search" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp"
        android:background="@drawable/bg_ui_card" android:hint="@string/memory_search_hint"
        android:inputType="text" android:maxLines="1" android:singleLine="true"
        android:drawableStart="@drawable/ic_ui_search" android:drawableTint="@color/text_caption" android:drawablePadding="10dp"
        android:paddingHorizontal="16dp" android:textColor="@color/on_surface" android:textColorHint="@color/on_surface_hint" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginHorizontal="20dp" android:background="@drawable/bg_ui_tonal" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/mui_learning_title" android:textSize="18sp" android:fontFamily="sans-serif-medium"
            android:drawableStart="@drawable/ic_ui_learning" android:drawableTint="@color/color_accent"
            android:drawablePadding="10dp" android:textColor="@color/on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/mui_learning_subtitle" android:textColor="@color/on_surface_medium" android:textSize="14sp" />
        <Button style="@style/OpenCyvis.Button.Custom" android:id="@+id/btn_memory_learning" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/mui_learning_open"
            android:textAllCaps="false" android:background="@drawable/bg_ui_pill" app:backgroundTint="@color/color_accent"
            android:textColor="@color/on_accent" android:paddingVertical="12dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button style="@style/OpenCyvis.Button.Custom" android:id="@+id/btn_memory_jobs" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:minHeight="48dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_ui_card" android:textColor="@color/on_brand_container"
            android:textAllCaps="false" android:text="@string/mem_jobs" />
        <Button style="@style/OpenCyvis.Button.Custom" android:id="@+id/btn_memory_episodes" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="48dp" android:paddingVertical="10dp"
            android:background="@drawable/bg_ui_card" android:textColor="@color/on_brand_container"
            android:textAllCaps="false" android:text="@string/mem_episodes" />
    </LinearLayout>
    <com.google.android.material.chip.ChipGroup android:id="@+id/memory_type_filters"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp"
        app:singleSelection="true" app:selectionRequired="true" app:singleLine="false"
        app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="4dp">
        <com.google.android.material.chip.Chip android:id="@+id/filter_memory_all"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:checkable="true" android:checked="true"
            android:text="@string/mp_filter_all" android:textSize="14sp" />
        <com.google.android.material.chip.Chip android:id="@+id/filter_memory_knowledge"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:checkable="true"
            android:text="@string/mp_filter_knowledge" android:textSize="14sp" />
        <com.google.android.material.chip.Chip android:id="@+id/filter_memory_methods"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:checkable="true"
            android:text="@string/mp_filter_methods" android:textSize="14sp" />
    </com.google.android.material.chip.ChipGroup>
    <TextView android:id="@+id/text_memory_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="10dp"
        android:textSize="13sp" android:textColor="@color/text_caption" />
    </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_memories"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingHorizontal="20dp" android:paddingBottom="16dp" />
        <TextView android:id="@+id/text_memory_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="24dp"
            android:textColor="@color/on_surface_medium" android:textSize="15sp" android:lineSpacingExtra="6dp"
            android:text="@string/mem_loading" />
    </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
