<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/bg_memory_knowledge" android:foreground="?android:attr/selectableItemBackground"
    android:padding="18dp" android:layout_marginBottom="12dp" android:minHeight="96dp"
    android:focusable="true" android:clickable="true">
    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:singleLine="false" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="4dp">
        <com.google.android.material.chip.Chip android:id="@+id/text_memory_type"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checkable="false" android:clickable="false" android:focusable="false"
            android:textColor="@color/on_brand_container" android:textSize="13sp"
            android:fontFamily="sans-serif-medium" app:chipMinHeight="32dp"
            app:chipBackgroundColor="@color/surface_elevated" app:chipStrokeWidth="0dp"
            app:ensureMinTouchTargetSize="false" app:chipIconVisible="true" app:chipIconTint="@color/on_brand_container" />
        <com.google.android.material.chip.Chip android:id="@+id/text_enabled"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checkable="false" android:clickable="false" android:focusable="false"
            android:textColor="@color/on_brand_container" android:textSize="13sp"
            app:chipMinHeight="32dp" app:chipStrokeWidth="0dp" app:ensureMinTouchTargetSize="false" />
    </com.google.android.material.chip.ChipGroup>
    <TextView android:id="@+id/text_memory_classification" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/on_surface_medium" android:textSize="13sp" />
    <TextView android:id="@+id/text_key" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/on_surface" android:textSize="18sp"
        android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/mp_summary"
        android:textColor="@color/on_surface_medium" android:textSize="12sp" />
    <TextView android:id="@+id/text_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/on_surface" android:textSize="15sp"
        android:maxLines="3" android:ellipsize="end" android:lineSpacingExtra="3dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginVertical="14dp" android:background="@color/outline" android:importantForAccessibility="no" />
    <TextView android:id="@+id/text_memory_source" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/on_surface_medium" android:textSize="13sp" android:lineSpacingExtra="3dp" />
    <TextView android:id="@+id/text_memory_confirmation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:textColor="@color/on_surface_medium" android:textSize="13sp" android:lineSpacingExtra="3dp" />
    <TextView android:id="@+id/text_memory_observation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:textColor="@color/on_surface_medium" android:textSize="13sp" android:lineSpacingExtra="3dp" />
    <TextView android:id="@+id/text_memory_scope" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="@color/text_caption" android:textSize="12sp" android:lineSpacingExtra="3dp" />
    <TextView android:id="@+id/text_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:textColor="@color/text_caption" android:textSize="12sp" android:lineSpacingExtra="3dp" />
</LinearLayout>
