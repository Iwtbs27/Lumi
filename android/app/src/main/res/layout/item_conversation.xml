<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="top"
    android:background="@drawable/bg_ui_card" android:foreground="?attr/selectableItemBackground"
    android:padding="16dp" android:layout_marginBottom="10dp" android:minHeight="96dp">
    <ImageView android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_ui_history" app:tint="@color/color_accent"
        android:padding="10dp" android:background="@drawable/bg_ui_tonal"
        android:layout_marginEnd="14dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/text_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/on_surface"
            android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="2dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/text_subtitle" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/on_surface_medium" android:textSize="12sp" />
            <TextView android:id="@+id/text_status" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:background="@drawable/bg_ui_pill" android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" android:textSize="12sp"
                android:textColor="@color/on_brand_container" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
