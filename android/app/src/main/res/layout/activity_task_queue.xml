<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface" android:fitsSystemWindows="true">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/task_queue_toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" app:title="@string/task_queue_title"
        app:titleTextColor="@color/on_surface" app:navigationIcon="@drawable/ic_ui_back"
        app:navigationContentDescription="@string/hs_back" />
    <TextView android:id="@+id/task_queue_connection" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="12dp"
        android:text="@string/task_queue_connecting" android:textSize="14sp"
        android:textColor="@color/on_surface_medium" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="12dp">
        <EditText android:id="@+id/task_queue_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp" android:maxLines="4"
            android:gravity="top|start" android:inputType="textCapSentences|textMultiLine"
            android:hint="@string/task_queue_input_hint" android:textSize="16sp"
            android:padding="16dp" android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_medium" android:background="@drawable/bg_ui_tonal" />
        <com.google.android.material.button.MaterialButton android:id="@+id/task_queue_add"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/task_queue_add"
            android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:id="@+id/task_queue_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="24dp" android:text="@string/task_queue_empty"
        android:textSize="16sp" android:textColor="@color/on_surface_medium" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/task_queue_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingHorizontal="24dp" android:paddingBottom="24dp" android:clipToPadding="false" />
</LinearLayout>
