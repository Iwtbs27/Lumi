<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="92dp"
    android:layout_margin="4dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_routine_chip" android:padding="14dp"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/chip_icon" android:layout_width="32dp" android:layout_height="40dp"
        android:gravity="center" android:textSize="22sp" android:layout_marginEnd="8dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/chip_text" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="@color/on_surface" android:textSize="14sp"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
