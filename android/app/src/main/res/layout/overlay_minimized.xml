<?xml version="1.0" encoding="utf-8"?>
<!-- Lumi mark stays opaque; the small badge carries the task state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="64dp"
    android:layout_height="64dp">

    <ImageView
        android:id="@+id/chat_head"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_chathead_improved"
        android:src="@drawable/ic_overlay_logo"
        android:scaleType="centerInside"
        android:padding="4dp"
        android:elevation="12dp"
        android:contentDescription="AI Agent" />

    <View
        android:id="@+id/chat_head_status"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_chathead_status"
        android:elevation="13dp"
        android:importantForAccessibility="no" />

</FrameLayout>
